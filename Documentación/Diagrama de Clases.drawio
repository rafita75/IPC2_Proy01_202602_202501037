        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\n\nclass Robot {\n    - nombre : string\n    - tipo : string\n    - capacidadCombate : int\n    + GetNombre() : string\n    + GetTipo() : string\n    + GetCapacidadCombate() : int\n}\n\nclass Celda {\n    - fila : int\n    - columna : int\n    - tipoTerreno : char\n    - capacidadMilitar : int\n    + GetFila() : int\n    + GetColumna() : int\n    + GetTipoTerreno() : char\n    + SetTipoTerreno(char)\n    + GetCapacidadMilitar() : int\n    + SetCapacidadMilitar(int)\n}\n\nclass Ciudad {\n    - nombre : string\n    - cantidadFilas : int\n    - cantidadColumnas : int\n    - malla : ListaMatriz\n    + GetNombre() : string\n    + GetCantidadFilas() : int\n    + GetCantidadColumnas() : int\n    + GetMalla() : ListaMatriz\n}\n\nclass NodoRobot {\n    - dato : Robot\n    - siguiente : NodoRobot\n    + GetDato() : Robot\n    + SetDato(Robot)\n    + GetSiguiente() : NodoRobot\n    + SetSiguiente(NodoRobot)\n}\n\nclass NodoCiudad {\n    - dato : Ciudad\n    - siguiente : NodoCiudad\n    + GetDato() : Ciudad\n    + SetDato(Ciudad)\n    + GetSiguiente() : NodoCiudad\n    + SetSiguiente(NodoCiudad)\n}\n\nclass NodoCelda {\n    - dato : Celda\n    - siguiente : NodoCelda\n    + GetDato() : Celda\n    + GetSiguiente() : NodoCelda\n    + SetSiguiente(NodoCelda)\n}\n\nclass NodoFila {\n    - dato : ListaCelda\n    - siguiente : NodoFila\n    + GetDato() : ListaCelda\n    + GetSiguiente() : NodoFila\n    + SetSiguiente(NodoFila)\n}\n\nclass ListaRobot {\n    - cabeza : NodoRobot\n    - contador : int\n    + Agregar(Robot)\n    + GetCabeza() : NodoRobot\n    + GetContador() : int\n}\n\nclass ListaCiudad {\n    - cabeza : NodoCiudad\n    - contador : int\n    + Agregar(Ciudad)\n    + BuscarCiudad(string) : Ciudad\n    + GetCabeza() : NodoCiudad\n    + GetContador() : int\n}\n\nclass ListaCelda {\n    - cabeza : NodoCelda\n    - contador : int\n    + Agregar(Celda)\n    + GetCabeza() : NodoCelda\n    + GetContador() : int\n}\n\nclass ListaMatriz {\n    - cabeza : NodoFila\n    - contador : int\n    + AgregarFila(ListaCelda)\n    + ObtenerCelda(int, int) : Celda\n}\n\nclass EstadoMision {\n    - celdaActual : Celda\n    - pasoAnterior : EstadoMision\n    - capacidadRestante : int\n    + GetCeldaActual() : Celda\n    + GetPasoAnterior() : EstadoMision\n    + GetCapacidadRestante() : int\n}\n\nclass NodoCola {\n    - dato : EstadoMision\n    - siguiente : NodoCola\n    + GetDato() : EstadoMision\n    + GetSiguiente() : NodoCola\n    + SetSiguiente(NodoCola)\n}\n\nclass Cola {\n    - frente : NodoCola\n    - final : NodoCola\n    + Encolar(EstadoMision)\n    + Desencolar() : EstadoMision\n    + EstaVacia() : bool\n}\n\nclass MotorMisiones {\n    - FueVisitada(ListaCelda, Celda) : bool\n    + EjecutarMision(Ciudad, Robot, char, int, int) : EstadoMision\n}\n\nclass LectorXML {\n    - ciudadesCargadas : ListaCiudad\n    - robotsCargados : ListaRobot\n    + CargarArchivo(string)\n}\n\nclass GeneradorGraphviz {\n    - ObtenerRuta(EstadoMision) : ListaCelda\n    - EsParteDeLaRuta(ListaCelda, Celda) : bool\n    + GenerarMapa(Ciudad, EstadoMision, string, Robot)\n}\n\nListaRobot \&quot;1\&quot; *-- \&quot;0..*\&quot; NodoRobot : Contiene\nNodoRobot \&quot;1\&quot; o-- \&quot;1\&quot; Robot : Almacena\n\nListaCiudad \&quot;1\&quot; *-- \&quot;0..*\&quot; NodoCiudad : Contiene\nNodoCiudad \&quot;1\&quot; o-- \&quot;1\&quot; Ciudad : Almacena\n\nCiudad \&quot;1\&quot; *-- \&quot;1\&quot; ListaMatriz : Posee\nListaMatriz \&quot;1\&quot; *-- \&quot;0..*\&quot; NodoFila : Contiene filas\nNodoFila \&quot;1\&quot; o-- \&quot;1\&quot; ListaCelda : Almacena columnas\nListaCelda \&quot;1\&quot; *-- \&quot;0..*\&quot; NodoCelda : Contiene\nNodoCelda \&quot;1\&quot; o-- \&quot;1\&quot; Celda : Almacena\n\nCola \&quot;1\&quot; *-- \&quot;0..*\&quot; NodoCola : Contiene\nNodoCola \&quot;1\&quot; o-- \&quot;1\&quot; EstadoMision : Almacena\nEstadoMision \&quot;1\&quot; o-- \&quot;1\&quot; Celda : Referencia a\nEstadoMision \&quot;1\&quot; o-- \&quot;1\&quot; EstadoMision : Paso anterior\n\nLectorXML ..&gt; ListaCiudad : Llena\nLectorXML ..&gt; ListaRobot : Llena\nMotorMisiones ..&gt; Cola : Usa\nMotorMisiones ..&gt; Ciudad : Recorre\nMotorMisiones ..&gt; Robot : Evalúa\nGeneradorGraphviz ..&gt; Ciudad : Dibuja\nGeneradorGraphviz ..&gt; EstadoMision : Rastrea\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="_yaGJR1Fpom9_4dYOzkT-158">
